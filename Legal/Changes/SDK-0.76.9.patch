+
+            fn bitmapRun(self: *RecordBuilder, lcn: u64, clusters: u64, data_size: u64) void {
+                self.nonResidentAttr(.bitmap, &[_]u8{}, &[_]RunSpec{.{ .lcn = lcn, .clusters = clusters }}, data_size, data_size, clusters * CLUSTER, 0);
