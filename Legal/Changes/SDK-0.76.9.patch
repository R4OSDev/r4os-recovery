+            std.mem.writeInt(u16, out[8..10], @intCast(len), .little);
+            std.mem.writeInt(u16, out[12..14], if (child_vcn != null) ntfs.INDEX_ENTRY_END | ntfs.INDEX_ENTRY_NODE else ntfs.INDEX_ENTRY_END, .little);
