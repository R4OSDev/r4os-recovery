+        fn entryLength(fn_value_len: usize, has_child: bool) usize {
+            var len = std.mem.alignForward(usize, 0x10 + fn_value_len, 8);
+            if (has_child) len += 8;
+            return len;
+        }
+
+        fn writeEntry(out: []u8, key: []const u8, child_vcn: ?u64) usize {
+            const fn_value = key[8..];
