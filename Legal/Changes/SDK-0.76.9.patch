+
+            const RunSpec = struct { lcn: ?u64, clusters: u64 };
+            const DataOpts = struct { init_size: ?u64 = null };
+
+            fn dataRun(self: *RecordBuilder, name_utf16: []const u8, lcn: u64, clusters: u64, data_size: u64, opts: DataOpts) void {
