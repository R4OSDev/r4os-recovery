+                    dot = i;
+                    continue;
+                }
+                const upper_ok = (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '-' or c == '~' or c == '$' or c == '@' or c == '!' or c == '#' or c == '%' or c == '&' or c == '\'' or c == '(' or c == ')' or c == '{' or c == '}' or c == '^' or c == '`';
