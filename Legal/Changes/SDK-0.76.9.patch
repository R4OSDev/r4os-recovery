+            std.mem.writeInt(u16, block[6..8], 9, .little);
+            std.mem.writeInt(u64, block[8..16], 0, .little);
+            std.mem.writeInt(u64, block[16..24], vcn, .little);
+            std.mem.writeInt(u32, block[0x18..][0..4], 0x28, .little); // entries_offset (rel 0x18)
