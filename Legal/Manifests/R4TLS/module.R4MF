# R4OS 0.55.19 security protocol project manifest.
R4OS_MODULE_MANIFEST=2
KIND=R4P
NAME=R4TLS
VERSION=0.2.5
LANGUAGE=Zig
SOURCE=src/main.zig
TARGET=/R4OS/PROTOCOLS/R4TLS.R4P
IMAGE_SCOPE=slim
IMPORT=R4DEV:Query:1
META=r4p.name=R4TLS
META=r4p.role=security.tls
META=r4p.category=data
META=module.name=R4P_R4TLS
META=description=Reusable TLS protocol foundation
META=feature=tls-server-handshake-plan
META=feature=tls-stream-io-contract
META=feature=tls12-crypto-core
META=feature=tls12-aes128-gcm-records
META=feature=tls12-rsa-pkcs1-sha256
META=feature=tls12-ecdsa-p256-p384
META=feature=tls12-derived-server-ecdh
META=feature=tls12-ecdhe-x25519-p256
META=feature=tls12-session-state
META=feature=tls12-live-session-state
META=feature=tls12-r4lk-app-records
META=feature=tls12-client-state
META=feature=tls12-extended-master-secret
META=feature=tls12-secure-renegotiation-signal
META=feature=tls12-session-ticket-offer
META=feature=x509-chain-validation
META=feature=external-root-catalog
META=consumer=RDPSVC,KLICKIFAX
